---
// Starlight's <head>, plus what search engines and link previews need:
// the sharing image (og:image) on every page and, on the home pages,
// structured data describing the app. The images are built by
// scripts/og-image.mjs.
import Default from '@astrojs/starlight/components/Head.astro';

const { lang, entry } = Astro.locals.starlightRoute;
const spanish = lang.startsWith('es');
const image = new URL(spanish ? '/og-es.png' : '/og.png', Astro.site).href;
const imageAlt = spanish
	? 'Partita, editor de partituras gratuito, con una partitura de piano abierta.'
	: 'Partita, the free music notation editor, with a piano score open.';

const home = spanish ? '/es/' : '/';
const isHome = Astro.url.pathname === home;
const repo = 'https://github.com/partita-notation/partita';
const jsonLd = isHome && {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			name: 'Partita',
			url: new URL('/', Astro.site).href,
		},
		{
			'@type': 'SoftwareApplication',
			name: 'Partita',
			description: entry.data.description,
			url: new URL(home, Astro.site).href,
			image,
			applicationCategory: 'MultimediaApplication',
			applicationSubCategory: spanish ? 'Editor de partituras' : 'Music notation software',
			operatingSystem: 'Windows, macOS, Linux',
			inLanguage: lang,
			isAccessibleForFree: true,
			license: 'https://www.gnu.org/licenses/gpl-3.0.html',
			downloadUrl: new URL(`${home}download/`, Astro.site).href,
			codeRepository: repo,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		},
	],
};
---

<Default><slot /></Default>
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={image} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
