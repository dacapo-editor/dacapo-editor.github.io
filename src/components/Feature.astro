---
// A feature row: text on one side, a close-up of the app on the other.
// Rows alternate sides with `flip`.
import Screenshot from './Screenshot.astro';

interface Props {
	title: string;
	alt: string;
	crop?: { x: number; y: number; w: number; h: number };
	/** An animation in public/ shown instead of a screenshot crop. */
	animation?: { src: string; width: number; height: number };
	flip?: boolean;
}
const { title, alt, crop, animation, flip = false } = Astro.props;
---

<section class:list={['feature', { flip }]}>
	<div class="text">
		<h2>{title}</h2>
		<slot />
	</div>
	{animation ? (
		<img class="animation" src={animation.src} width={animation.width} height={animation.height} alt={alt} loading="lazy" />
	) : (
		<Screenshot alt={alt} crop={crop} frame={false} />
	)}
</section>

<style>
	.feature {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		align-items: center;
		margin-block: 3.5rem;
	}
	@media (min-width: 50rem) {
		.feature {
			grid-template-columns: 1fr 1.25fr;
			gap: 3rem;
		}
		.feature.flip {
			grid-template-columns: 1.25fr 1fr;
		}
		.feature.flip .text {
			order: 2;
		}
	}
.animation {
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		background: #fffdf8;
		box-shadow: 0 1.5rem 3.5rem -1.5rem rgb(0 0 0 / 0.45), 0 0 0 1px var(--sl-color-hairline);
	}
	.text h2 {
		margin-top: 0;
		font-size: var(--sl-text-3xl);
		line-height: 1.15;
	}
	.text :global(p) {
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
</style>
